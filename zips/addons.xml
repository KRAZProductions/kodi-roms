<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.kraz.roms.jaguar" name="Atari Jaguar ROMs" version="1.0.0" provider-name="KRAZ Productions">
  <requires><import addon="xbmc.python" version="3.0.0"/></requires>
  <extension point="xbmc.python.script" library="service.py">
    <provides>executable game</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">2 Atari Jaguar games for SQUID-MBC</summary>
    <description lang="en_GB">Installs 2 Atari Jaguar ROMs into SQUID's games folder and adds the games source.</description>
    <platform>all</platform>
  </extension>
</addon>
